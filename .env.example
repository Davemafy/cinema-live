# Server-only backend connection. Change these two values to switch worker hosts.
# No credentials in URLs, no NEXT_PUBLIC_ prefix, no provider-specific code edits.
CINEMA_BACKEND_URL=
CINEMA_BACKEND_TOKEN=
# Existing independent application secret, at least 32 characters. Keep it stable.
# Required for new AND legacy worker connections. Never derive it from a worker token.
JOB_SIGNING_SECRET=

# Optional existing paid fal integration. No budget authorization = keep disabled.
FAL_KEY=
INFERENCE_ENABLED=false
CINEMA_RENDER_CODE=
FFMPEG_PATH=
FFPROBE_PATH=

# Legacy configurations remain supported when BOTH new backend values are absent.
# Preserve existing values until the new pair is verified. Prefer the pair above.
CINEMA_KAGGLE_URL=
CINEMA_KAGGLE_TOKEN=
CINEMA_CINEMATOGRAPHY_URL=
# Explicit local development only; production rejects local origins.
CINEMA_ALLOW_LOCAL_ENGINE=false
