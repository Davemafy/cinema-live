# Add secrets through your host's secret configuration. Never commit real values.
FAL_KEY=
# Generate a stable random secret of at least 32 characters for signed job tokens.
JOB_SIGNING_SECRET=
# Requires explicit budget authorization; absent/false keeps inference disabled.
INFERENCE_ENABLED=false
# Optional shared render code for a limited judge/demo deployment (no accounts).
CINEMA_RENDER_CODE=
# Optional paths for a local host with FFmpeg already installed.
FFMPEG_PATH=
FFPROBE_PATH=
